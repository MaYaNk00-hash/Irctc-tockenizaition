# Required for a secure production deployment. Generate this value yourself.
JWT_SECRET=

# Optional: add managed Postgres/Redis connection strings to persist demo state.
# The prototype uses its existing in-memory fallback when these are unset.
DATABASE_URL=
REDIS_URL=

# Optional: only needed when the frontend is hosted on a different origin.
CORS_ORIGIN=

# Optional: leave unset for one-project Vercel Services deployment (same-origin API calls).
NEXT_PUBLIC_API_URL=
