# Required for a secure production deployment. Generate a 32+ character random value.
JWT_SECRET=07968ae3-6abd-44a9-afec-965a84279dbf

# PostgreSQL connection string from Supabase (Project Settings -> Database).
# Use the Session Pooler URI for serverless/Vercel deployments when available.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres:irctc-for-codex-banglore@db.klkwvkftyfpbfjxmautp.supabase.co:5432/postgres
DB_SSL=true
DB_IPV4=true
REDIS_URL=

# Authentication uses PostgreSQL for user records and Redis for distributed
# login/signup rate limiting. Both are required when using /api/auth endpoints.

# Optional: only needed when the frontend is hosted on a different origin.
CORS_ORIGIN=

# Optional: leave unset for one-project Vercel Services deployment (same-origin API calls).
NEXT_PUBLIC_API_URL=

# For Supabase, use the Session Pooler URI for Vercel/serverless deployments.
# Run `cd backend && npm run db:migrate` once before using the hosted app.