{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    { "src": "backend/src/server.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/src/server.ts" },
    { "src": "/waiting-room/(.*)", "dest": "/backend/src/server.ts" },
    { "src": "/booking/(.*)", "dest": "/backend/src/server.ts" },
    { "src": "/health", "dest": "/backend/src/server.ts" },
    { "src": "/ready", "dest": "/backend/src/server.ts" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
